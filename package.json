{
  "name": "cermuel-hooks",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "create:hook": "node scripts/create-hook.ts",
    "remove:hook": "node scripts/remove-hook.ts",
    "generate:hooks-registry": "node scripts/generate-hooks-registry.ts",
    "check:hooks": "node scripts/check-hooks.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm check:hooks && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vue-eslint-parser": "^10.2.0",
    "vitest": "^3.2.4"
  }
}
